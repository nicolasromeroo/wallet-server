// DESARROLLO - SQLITE (Archivo local sin instalación)
generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  createdAt DateTime @default(now())

  // relaciones de notas, sueldos y gastos
  sueldos       Sueldo[]
  gastos        Gasto[]
  notes         Note[]
  monthArchives MonthArchive[]

  // movimientos Movimiento[] (TO DO)
}

model Sueldo {
  id    String   @id @default(uuid())
  monto Float
  tipo  String   @default("SUELDO")
  fecha DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])
  notes  Note[]
}

model Gasto {
  id               String   @id @default(uuid())
  descripcion      String
  monto            Float
  fecha            DateTime @default(now())
  categoria        String? // ML: categoría inferida
  esExtraordinario Boolean  @default(false)

  userId String
  user   User   @relation(fields: [userId], references: [id])
  notes  Note[]
}

model AnalyticsSnapshot {
  id           String   @id @default(uuid())
  userId       String
  mes          Int
  anio         Int
  burnRate     Float    @default(0)
  totalGastos  Float    @default(0)
  totalSueldos Float    @default(0)
  ahorroProy   Float    @default(0)
  diasElapsed  Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, mes, anio])
}

model Note {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  createdAt   DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  sueldoId String?
  sueldo   Sueldo? @relation(fields: [sueldoId], references: [id])

  gastoId String?
  gasto   Gasto?  @relation(fields: [gastoId], references: [id])
}

model MonthArchive {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  mes          Int
  anio         Int
  totalGastos  Float
  totalSueldos Float
  saldo        Float
  nota         String?
  gastosJson   String
  sueldosJson  String
  archivedAt   DateTime @default(now())

  @@unique([userId, mes, anio])
}
