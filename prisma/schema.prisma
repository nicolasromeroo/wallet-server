// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  createdAt DateTime @default(now())

  // relaciones de notas, sueldos y gastos
  sueldos Sueldo[]
  gastos  Gasto[]
  notes   Note[]

  // movimientos Movimiento[] (TO DO)
}

model Sueldo {
  id    String   @id @default(uuid())
  monto Float
  tipo  String   @default("SUELDO")
  fecha DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])
  notes  Note[]
}

model Gasto {
  id               String   @id @default(uuid())
  descripcion      String
  monto            Float
  fecha            DateTime @default(now())
  categoria        String? // ML: categoría inferida
  esExtraordinario Boolean  @default(false)

  userId String
  user   User   @relation(fields: [userId], references: [id])
  noteId Int?   @unique
  note   Note?  @relation(fields: [noteId], references: [id])
}

model AnalyticsSnapshot {
  id           String   @id @default(uuid())
  userId       String
  mes          Int
  anio         Int
  burnRate     Float    @default(0)
  totalGastos  Float    @default(0)
  totalSueldos Float    @default(0)
  ahorroProy   Float    @default(0)
  diasElapsed  Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, mes, anio])
}

model Note {
  id          Int    @id @default(autoincrement())
  title       String
  description String

  userId String
  user   User   @relation(fields: [userId], references: [id])

  sueldoId String?
  sueldo   Sueldo? @relation(fields: [sueldoId], references: [id])

  gasto Gasto? // telación inversa ( sin "fields" ni "references")
}
